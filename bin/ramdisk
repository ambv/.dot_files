#!/usr/bin/env python3

import getpass
import os
from pathlib import Path
import subprocess
import sys
import time


CPYTHON = Path.home() / "Python" / "cpython.git"
VSCODE = Path.home() / "Python" / "cpython-vscode-workspace"
RAMDISK = Path("/Volumes/RAMDisk")
WORKTREE = RAMDISK / "cpython"
BRANCH = "main"
RAMDISK_SIZE_GIB = 10


def run(command, **kwargs):
    """Run a command, displaying it and stopping if it fails."""
    print(f"+ {' '.join(map(str, command))}")
    return subprocess.run(command, check=True, **kwargs)


if RAMDISK.is_dir():
    print(f"RAM disk already exists at {RAMDISK}. Unmount by running:")
    print(f"\n    hdiutil eject {RAMDISK}\n")
    sys.exit(1)

if not CPYTHON.is_dir():
    print(f"CPython checkout not found at {CPYTHON}.", file=sys.stderr)
    sys.exit(1)

sudo_prompted = subprocess.run(
    ["sudo", "-nv"],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
).returncode != 0

if sudo_prompted:
    print("This script requires admin privileges to set ownership properly.")
    run(["sudo", "-v"])

try:
    worktree_output = subprocess.run(
        ["git", "-C", CPYTHON, "worktree", "list", "--porcelain"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    for line in worktree_output.splitlines():
        if not line.startswith("worktree "):
            continue
        stale_worktree = Path(line.removeprefix("worktree "))
        if stale_worktree == RAMDISK or RAMDISK in stale_worktree.parents:
            print(f"Stale CPython worktree found in {stale_worktree}, deleting.")
            run(["git", "-C", CPYTHON, "worktree", "remove", stale_worktree])

    # hdiutil RAM-disk sizes are specified in 512-byte sectors.
    sectors = RAMDISK_SIZE_GIB * 1024**3 // 512
    disk_id = subprocess.run(
        ["hdiutil", "attach", "-nobrowse", "-nomount", f"ram://{sectors}"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()

    print(f"Creating a {RAMDISK_SIZE_GIB} GiB RAM disk at {disk_id}...")
    print("Waiting for it to initialize", end="", flush=True)
    while subprocess.run(
        ["diskutil", "list", disk_id],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode != 0:
        print(".", end="", flush=True)
        time.sleep(1)
    print(" done!")

    print("Formatting the RAM disk...")
    run(["diskutil", "erasevolume", "HFS+", "RAMDisk", disk_id])
    run(["git", "-C", CPYTHON, "worktree", "add", WORKTREE, BRANCH])

    run(["sudo", "diskutil", "enableOwnership", disk_id])
    run(["sudo", "chown", f"{getpass.getuser()}:staff", RAMDISK])
    os.symlink(VSCODE, WORKTREE / ".vscode")
finally:
    if sudo_prompted:
        subprocess.run(["sudo", "-k"], check=False)

print("All done. Switch to the RAM disk checkout by running:")
print(f"\n    cd {WORKTREE}\n")
